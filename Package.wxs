<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Nusamba NodeCore Agent" 
           Manufacturer="BPR Nusamba" 
           Version="3.0.0.0" 
           UpgradeCode="4f65c92e-bdf1-432a-8742-990a1b8c2d3e" 
           Scope="perMachine"
           Architecture="x64">
    
    <MajorUpgrade DowngradeErrorMessage="Versi yang lebih baru dari Nusamba NodeCore Agent sudah terpasang." Schedule="afterInstallInitialize" />
    
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Nusamba NodeCore">
        <Component Id="MainExecutable" Guid="98a12bc4-f567-4e89-abcd-0123456789ef">
          <File Id="NodeCoreEXE" Source="publish\NusambaNode.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Nusamba NodeCore">
        <Component Id="ApplicationShortcut" Guid="78b901cd-e234-4567-89ab-cdef01234567">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Nusamba NodeCore Agent"
                    Description="Nusamba NodeCore Endpoint Management &amp; Remote Assistance"
                    Target="[INSTALLFOLDER]NusambaNode.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NusambaNodeCore\Agent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Nusamba NodeCore Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <CustomAction Id="LaunchApplication" 
                  FileRef="NodeCoreEXE" 
                  ExeCommand="" 
                  Execute="immediate" 
                  Impersonate="yes" 
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
